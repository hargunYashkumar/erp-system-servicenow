        <name>Validate Points Earned</name>
        <order/>
        <script><![CDATA[
function onSubmit() {
    var pointsPossible = parseFloat(g_form.getValue('points_possible'));
    var pointsEarned = parseFloat(g_form.getValue('points_earned'));

    if (pointsEarned > pointsPossible) {
        g_form.addErrorMessage('Points Earned cannot be greater than Points Possible.');
        g_form.showFieldMsg('points_earned', 'Points Earned must be less than or equal to Points Possible.', 'error');

        return false;
    }

    return true;
}
]]></script>
