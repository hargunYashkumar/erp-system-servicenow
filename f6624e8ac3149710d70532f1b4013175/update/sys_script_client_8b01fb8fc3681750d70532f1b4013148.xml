        <condition/>
        <description>Validate Round No should be positive</description>
        <field>round_no</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Round No Positive</name>
        <order>100</order>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        g_form.hideFieldMsg('round_no', true);
        return;
    }

    var round = parseInt(newValue, 10);
    g_form.hideFieldMsg('round_no', true);

    if (isNaN(round) || round <= 0) {
        g_form.showFieldMsg('round_no', 'Round No must be greater than zero.', 'error');
    }
}]]></script>
