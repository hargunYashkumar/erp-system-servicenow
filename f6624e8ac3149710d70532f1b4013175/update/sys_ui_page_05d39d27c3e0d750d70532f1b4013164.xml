          &lt;div class="edu-node"&gt;Section&lt;small&gt;x_..._section&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Timetable Entry&lt;small&gt;x_..._timetable_entry&lt;/small&gt;&lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;!-- Flow 3 --&gt;
      &lt;div class="edu-flow-lane"&gt;
        &lt;div class="edu-flow-title"&gt;&amp;#128221; Examination &amp;amp; Evaluation Pipeline&lt;/div&gt;
        &lt;div class="edu-flow-nodes"&gt;
          &lt;div class="edu-node"&gt;Exam Event&lt;small&gt;x_..._exam_event&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Exam Schedule&lt;small&gt;x_..._exam_schedule&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
