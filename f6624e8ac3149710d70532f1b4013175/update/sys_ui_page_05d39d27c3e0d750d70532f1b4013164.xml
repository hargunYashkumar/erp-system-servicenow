        <html>&lt;?xml version="1.0" encoding="utf-8" ?&gt;
&lt;j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null"&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;title&gt;EduSphere University ERP - Data Model &amp;amp; Architecture&lt;/title&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0" /&gt;
  &lt;style&gt;
    :root {
      --bg-base: #0b1120;
      --bg-card: #111827;
      --bg-card-hover: #1e293b;
      --border-color: rgba(255, 255, 255, 0.08);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --gold-primary: #c2882f;
      --gold-light: #fbbf24;
      --gold-bg: rgba(194, 136, 47, 0.12);
      --emerald: #10b981;
      --blue: #3b82f6;
    }

    [data-theme="light"] {
      --bg-base: #f8fafc;
      --bg-card: #ffffff;
      --bg-card-hover: #f1f5f9;
      --border-color: #e2e8f0;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --gold-primary: #92400e;
      --gold-light: #b45309;
      --gold-bg: rgba(194, 136, 47, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg-base);
      color: var(--text-main);
      line-height: 1.5;
      padding: 24px;
      transition: background 0.25s, color 0.25s;
    }

    .edu-container { max-width: 1400px; margin: 0 auto; }

    /* Header */
    .edu-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .edu-brand { display: flex; align-items: center; gap: 14px; }
    .edu-brand-logo {
      width: 44px; height: 44px;
      background: linear-gradient(135deg, #1e3a8a, #0b1120);
      border: 2px solid var(--gold-primary);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
    }
    .edu-brand h1 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
    .edu-brand p { font-size: 13px; color: var(--text-muted); }

    .edu-header-actions { display: flex; align-items: center; gap: 10px; }
    .edu-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      text-decoration: none; cursor: pointer; border: none; transition: all 0.2s;
    }
    .edu-btn-gold {
      background: var(--gold-primary); color: #ffffff !important;
    }
    .edu-btn-gold:hover { opacity: 0.9; }
    .edu-btn-ghost {
      background: transparent; color: var(--text-main) !important;
      border: 1px solid var(--border-color);
    }
    .edu-btn-ghost:hover { background: var(--bg-card-hover); }

    /* Stats Bar */
    .edu-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }
    .edu-stat-box {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px 20px;
      display: flex; align-items: center; gap: 14px;
    }
    .edu-stat-icon {
      width: 42px; height: 42px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2);
    }
    .edu-stat-num { font-size: 22px; font-weight: 800; color: var(--text-main); }
    .edu-stat-label { font-size: 12px; color: var(--text-muted); }

    /* Controls Bar */
    .edu-controls {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .edu-search-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .edu-search-wrap {
      flex: 1; min-width: 280px; position: relative;
    }
    .edu-search-input {
      width: 100%;
      padding: 10px 14px 10px 38px;
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-main);
      font-size: 14px;
    }
    .edu-search-input:focus { outline: none; border-color: var(--gold-primary); }
    .edu-search-icon {
      position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
      font-size: 15px; color: var(--text-muted);
    }

    .edu-view-tabs { display: flex; gap: 6px; }
    .edu-tab-btn {
      padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600;
      cursor: pointer; background: transparent; border: 1px solid transparent;
      color: var(--text-muted); transition: all 0.2s;
    }
    .edu-tab-btn.active {
      background: var(--gold-bg); color: var(--gold-light);
      border-color: rgba(194, 136, 47, 0.4);
    }

    /* Filter Pills */
    .edu-filter-pills {
      display: flex; flex-wrap: wrap; gap: 8px;
      padding-top: 10px; border-top: 1px solid var(--border-color);
    }
    .edu-pill {
      padding: 5px 12px; border-radius: 9999px; font-size: 12px; font-weight: 500;
      background: var(--bg-base); border: 1px solid var(--border-color);
      color: var(--text-muted); cursor: pointer; transition: all 0.2s;
    }
    .edu-pill:hover, .edu-pill.active {
      background: var(--gold-bg); border-color: rgba(194, 136, 47, 0.4);
      color: var(--gold-light);
    }

    /* Module Section */
    .edu-module-block {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 22px;
      margin-bottom: 24px;
      transition: all 0.2s;
    }
    .edu-module-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 16px; padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
      flex-wrap: wrap; gap: 8px;
    }
    .edu-module-title { display: flex; align-items: center; gap: 10px; }
    .edu-module-title h2 { font-size: 18px; font-weight: 700; }
    .edu-module-tag {
      font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9999px;
      background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .edu-module-desc { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; }

    /* Tables Grid inside Module */
    .edu-tables-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 14px;
    }
    .edu-table-card {
      background: var(--bg-base);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 14px 16px;
      display: flex; flex-direction: column; justify-content: space-between;
      transition: transform 0.2s, border-color 0.2s;
    }
    .edu-table-card:hover {
      transform: translateY(-2px);
      border-color: rgba(194, 136, 47, 0.4);
    }
    .edu-table-top { margin-bottom: 10px; }
    .edu-table-label { font-size: 15px; font-weight: 700; color: var(--text-main); margin-bottom: 2px; }
    .edu-table-name {
      font-size: 11px; font-family: monospace; color: var(--gold-light);
      word-break: break-all;
    }
    .edu-table-desc { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
    .edu-table-actions {
      display: flex; gap: 8px; margin-top: 12px; padding-top: 10px;
      border-top: 1px solid var(--border-color);
    }
    .edu-btn-action {
      flex: 1; padding: 5px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;
      text-align: center; text-decoration: none; border: 1px solid var(--border-color);
      background: var(--bg-card); color: var(--text-main) !important; transition: all 0.15s;
    }
    .edu-btn-action:hover {
      background: var(--gold-bg); border-color: rgba(194, 136, 47, 0.4);
      color: var(--gold-light) !important;
    }
    .edu-btn-action.primary {
      background: rgba(16, 185, 129, 0.12); color: #34d399 !important; border-color: rgba(16, 185, 129, 0.3);
    }
    .edu-btn-action.primary:hover { background: rgba(16, 185, 129, 0.25); }

    /* Dictionary Table View */
    .edu-dict-wrap {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow-x: auto;
      display: none;
    }
    .edu-dict-table {
      width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;
    }
    .edu-dict-table th {
      background: var(--bg-base); padding: 12px 16px;
      border-bottom: 2px solid var(--border-color); font-weight: 700;
      color: var(--text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;
    }
    .edu-dict-table td {
      padding: 12px 16px; border-bottom: 1px solid var(--border-color);
    }
    .edu-dict-table tr:hover td { background: var(--bg-card-hover); }

    /* ERD View */
    .edu-erd-wrap {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
      display: none;
      overflow-x: auto;
    }
    .edu-erd-schema {
      display: flex; flex-direction: column; gap: 24px;
    }
    .edu-flow-lane {
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 16px;
      background: var(--bg-base);
    }
    .edu-flow-title {
      font-size: 14px; font-weight: 700; color: var(--gold-light);
      margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
    }
    .edu-flow-nodes {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .edu-node {
      padding: 10px 14px; border-radius: 8px;
      background: var(--bg-card); border: 1px solid rgba(194, 136, 47, 0.3);
      font-size: 13px; font-weight: 600; color: var(--text-main);
      display: flex; flex-direction: column; gap: 2px;
    }
    .edu-node small { font-size: 10px; color: var(--text-muted); font-family: monospace; }
    .edu-arrow { font-size: 18px; color: var(--gold-primary); }

    /* Empty state */
    .edu-empty {
      text-align: center; padding: 48px 24px; color: var(--text-muted);
      display: none;
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body data-theme="dark"&gt;

&lt;div class="edu-container"&gt;

  &lt;!-- Header --&gt;
  &lt;header class="edu-header"&gt;
    &lt;div class="edu-brand"&gt;
      &lt;div class="edu-brand-logo"&gt;&amp;#127979;&lt;/div&gt;
      &lt;div&gt;
        &lt;h1&gt;EduSphere University ERP &amp;bull; Data Model &amp;amp; Architecture&lt;/h1&gt;
        &lt;p&gt;Comprehensive Entity Relationship &amp;amp; Table Directory across 13 Functional Modules (70 Scoped Tables)&lt;/p&gt;
