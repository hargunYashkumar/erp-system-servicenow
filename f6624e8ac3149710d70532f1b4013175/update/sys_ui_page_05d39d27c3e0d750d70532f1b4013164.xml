          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Hall Ticket&lt;small&gt;x_..._hall_ticket&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Mark Entry&lt;small&gt;x_..._mark&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Official Result&lt;small&gt;x_..._result&lt;/small&gt;&lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;!-- Flow 4 --&gt;
      &lt;div class="edu-flow-lane"&gt;
        &lt;div class="edu-flow-title"&gt;&amp;#128176; Student Fee &amp;amp; Accounting Flow&lt;/div&gt;
        &lt;div class="edu-flow-nodes"&gt;
          &lt;div class="edu-node"&gt;Fee Structure&lt;small&gt;x_..._fee_structure&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Student Fee Due&lt;small&gt;x_..._student_fee&lt;/small&gt;&lt;/div&gt;
          &lt;span class="edu-arrow"&gt;&amp;rarr;&lt;/span&gt;
          &lt;div class="edu-node"&gt;Payment Transaction&lt;small&gt;x_..._payment_transaction&lt;/small&gt;&lt;/div&gt;
