  function renderDictionary() {
    var tbody = document.getElementById('dictTableBody');
    tbody.innerHTML = '';
    var searchVal = (document.getElementById('tableSearch').value || '').toLowerCase().trim();

    var count = 1;
    modulesData.forEach(function(mod) {
      if (currentModuleFilter !== 'all' &amp;&amp; mod.id !== currentModuleFilter) return;

      mod.tables.forEach(function(t) {
        if (searchVal) {
          var match = t.label.toLowerCase().indexOf(searchVal) !== -1 ||
                      t.name.toLowerCase().indexOf(searchVal) !== -1 ||
                      t.desc.toLowerCase().indexOf(searchVal) !== -1 ||
                      mod.name.toLowerCase().indexOf(searchVal) !== -1;
          if (!match) return;
        }

        var tr = document.createElement('tr');
        tr.innerHTML = '&lt;td&gt;&lt;strong&gt;' + (count++) + '&lt;/strong&gt;&lt;/td&gt;' +
          '&lt;td&gt;&lt;span style="display:inline-flex;align-items:center;gap:6px;"&gt;' + mod.icon + ' ' + mod.name + '&lt;/span&gt;&lt;/td&gt;' +
          '&lt;td&gt;&lt;strong&gt;' + t.label + '&lt;/strong&gt;&lt;/td&gt;' +
          '&lt;td&gt;&lt;code style="font-size:11px;color:var(--gold-light);"&gt;' + t.name + '&lt;/code&gt;&lt;/td&gt;' +
          '&lt;td&gt;' + t.desc + '&lt;/td&gt;' +
          '&lt;td style="white-space:nowrap;"&gt;' +
            '&lt;a href="/' + t.name + '_list.do" target="_blank" class="edu-btn edu-btn-ghost" style="padding:4px 8px;font-size:11px;margin-right:4px;"&gt;&amp;#128203; List&lt;/a&gt;' +
            '&lt;a href="/$schema_map.do?sysparm_table=' + t.name + '" target="_blank" class="edu-btn edu-btn-ghost" style="padding:4px 8px;font-size:11px;"&gt;&amp;#128506;&amp;#65039; Map&lt;/a&gt;' +
          '&lt;/td&gt;';
        tbody.appendChild(tr);
      });
    });
  }

  function filterTables() {
    renderCards();
    renderDictionary();
  }

  function filterByModule(modId, btn) {
    currentModuleFilter = modId;
    var pills = document.querySelectorAll('#modulePills .edu-pill');
    pills.forEach(function(p) { p.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    renderCards();
    renderDictionary();
  }

  function switchView(view) {
    document.getElementById('tabCards').classList.remove('active');
    document.getElementById('tabErd').classList.remove('active');
    document.getElementById('tabDict').classList.remove('active');

    document.getElementById('viewCards').style.display = 'none';
    document.getElementById('viewErd').style.display = 'none';
    document.getElementById('viewDict').style.display = 'none';

    if (view === 'cards') {
      document.getElementById('tabCards').classList.add('active');
      document.getElementById('viewCards').style.display = 'block';
    } else if (view === 'erd') {
      document.getElementById('tabErd').classList.add('active');
      document.getElementById('viewErd').style.display = 'block';
    } else if (view === 'dict') {
      document.getElementById('tabDict').classList.add('active');
      document.getElementById('viewDict').style.display = 'block';
    }
  }

  window.onload = initPage;
