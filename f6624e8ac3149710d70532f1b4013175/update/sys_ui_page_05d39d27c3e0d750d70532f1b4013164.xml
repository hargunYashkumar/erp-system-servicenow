  function initPage() {
    var savedTheme = localStorage.getItem('edusphere_theme') || 'dark';
    document.body.setAttribute('data-theme', savedTheme);
    updateThemeBtn(savedTheme);
    renderCards();
    renderDictionary();
  }

  function toggleTheme() {
    var cur = document.body.getAttribute('data-theme') || 'dark';
    var next = (cur === 'dark') ? 'light' : 'dark';
    document.body.setAttribute('data-theme', next);
    localStorage.setItem('edusphere_theme', next);
    updateThemeBtn(next);
  }

  function updateThemeBtn(theme) {
    var btn = document.getElementById('themeBtn');
    if (btn) {
      btn.innerHTML = (theme === 'dark') ? '&amp;#9728;&amp;#65039; Light Mode' : '&amp;#127769; Dark Mode';
    }
  }

  function renderCards() {
    var container = document.getElementById('viewCards');
    container.innerHTML = '';
    var searchVal = (document.getElementById('tableSearch').value || '').toLowerCase().trim();

    var totalMatches = 0;

    modulesData.forEach(function(mod) {
      if (currentModuleFilter !== 'all' &amp;&amp; mod.id !== currentModuleFilter) return;

      var filteredTables = mod.tables.filter(function(t) {
        if (!searchVal) return true;
        return t.label.toLowerCase().indexOf(searchVal) !== -1 ||
               t.name.toLowerCase().indexOf(searchVal) !== -1 ||
               t.desc.toLowerCase().indexOf(searchVal) !== -1 ||
               mod.name.toLowerCase().indexOf(searchVal) !== -1;
      });

      if (filteredTables.length === 0) return;
      totalMatches += filteredTables.length;

      var block = document.createElement('div');
      block.className = 'edu-module-block';
      block.id = 'mod-' + mod.id;

      var html = '&lt;div class="edu-module-header"&gt;' +
        '&lt;div class="edu-module-title"&gt;' +
          '&lt;span style="font-size:22px;"&gt;' + mod.icon + '&lt;/span&gt;' +
          '&lt;h2&gt;' + mod.name + '&lt;/h2&gt;' +
          '&lt;span class="edu-module-tag"&gt;' + filteredTables.length + ' Tables&lt;/span&gt;' +
        '&lt;/div&gt;' +
        '&lt;a href="/$schema_map.do?sysparm_table=' + filteredTables[0].name + '" target="_blank" class="edu-btn edu-btn-ghost" style="font-size:11px;padding:4px 8px;"&gt;&amp;#128506;&amp;#65039; Module Schema&lt;/a&gt;' +
      '&lt;/div&gt;' +
      '&lt;div class="edu-module-desc"&gt;' + mod.desc + '&lt;/div&gt;' +
      '&lt;div class="edu-tables-grid"&gt;';

      filteredTables.forEach(function(t) {
        html += '&lt;div class="edu-table-card"&gt;' +
          '&lt;div class="edu-table-top"&gt;' +
            '&lt;div class="edu-table-label"&gt;' + t.label + '&lt;/div&gt;' +
            '&lt;div class="edu-table-name"&gt;' + t.name + '&lt;/div&gt;' +
            '&lt;div class="edu-table-desc"&gt;' + t.desc + '&lt;/div&gt;' +
          '&lt;/div&gt;' +
          '&lt;div class="edu-table-actions"&gt;' +
            '&lt;a href="/' + t.name + '_list.do" target="_blank" class="edu-btn-action primary"&gt;&amp;#128203; List&lt;/a&gt;' +
            '&lt;a href="/' + t.name + '.do" target="_blank" class="edu-btn-action"&gt;&amp;#10133; New&lt;/a&gt;' +
            '&lt;a href="/$schema_map.do?sysparm_table=' + t.name + '" target="_blank" class="edu-btn-action" title="Open Native Schema Map"&gt;&amp;#128506;&amp;#65039; Map&lt;/a&gt;' +
          '&lt;/div&gt;' +
        '&lt;/div&gt;';
      });

      html += '&lt;/div&gt;';
      block.innerHTML = html;
      container.appendChild(block);
    });

    var empty = document.getElementById('emptyState');
    if (totalMatches === 0) {
      empty.style.display = 'block';
    } else {
      empty.style.display = 'none';
