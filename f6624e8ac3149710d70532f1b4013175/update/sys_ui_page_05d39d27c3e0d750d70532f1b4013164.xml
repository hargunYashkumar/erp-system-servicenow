  &lt;!-- VIEW 2: ERD &amp; ARCHITECTURE --&gt;
  &lt;div id="viewErd" class="edu-erd-wrap"&gt;
    &lt;div class="edu-erd-schema"&gt;
      &lt;!-- Flow 1 --&gt;
      &lt;div class="edu-flow-lane"&gt;
        &lt;div class="edu-flow-title"&gt;&amp;#127979; University &amp;amp; Admission Intake Flow&lt;/div&gt;
        &lt;div class="edu-flow-nodes"&gt;
          &lt;div class="edu-node"&gt;University&lt;small&gt;x_..._university&lt;/small&gt;&lt;/div&gt;
