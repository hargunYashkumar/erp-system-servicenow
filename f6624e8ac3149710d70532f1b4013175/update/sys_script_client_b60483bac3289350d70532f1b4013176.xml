        <messages/>
        <name>Validate Check-in and Check-out Hours</name>
        <order/>
        <script><![CDATA[
function onSubmit() {
    var checkIn = g_form.getValue('check_in');
    var checkOut = g_form.getValue('check_out');

    if (!checkIn || !checkOut) {
        return true;
    }

    var start = new Date(checkIn);
    var end = new Date(checkOut);

    if (end <= start) {
        g_form.addErrorMessage('Check Out must be after Check In.');
        return false;
    }

    var diffMs = end.getTime() - start.getTime();
    var totalHours = diffMs / (1000 * 60 * 60);

    g_form.setValue('hours', totalHours.toFixed(2));

    return true;
}
]]></script>
