        <name>Validate Amount Greater Than Zero</name>
        <order/>
        <script><![CDATA[function onSubmit() {

    var amount = parseFloat(g_form.getValue('amount').replace(/[^0-9.\-]/g, ''));

    if (isNaN(amount) || amount <= 0) {
        g_form.addErrorMessage('Amount must be greater than zero.');
        g_form.getControl('amount').focus();
        return false;
    }
}]]></script>
