        <order>100</order>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        g_form.hideFieldMsg('package_lpa', true);
        return;
    }

    var packageVal = parseFloat(newValue.replace(/[^0-9.-]+/g, ''));
    g_form.hideFieldMsg('package_lpa', true);

    if (isNaN(packageVal) || packageVal <= 0) {
        g_form.showFieldMsg('package_lpa', 'Package LPA must be greater than zero.', 'error');
    }
}]]></script>
