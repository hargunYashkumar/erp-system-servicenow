        <name>Validate Start Date Before End Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {

    var startDate = g_form.getValue('start_date');
    var endDate = g_form.getValue('end_date');

    if (startDate && endDate &&
        getDateFromFormat(startDate, g_user_date_format) >= getDateFromFormat(endDate, g_user_date_format)) {
        g_form.addErrorMessage('Start Date must be before End Date.');
        g_form.getControl('end_date').focus();
        return false;
    }
}]]></script>
